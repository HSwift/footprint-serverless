{
  "name": "footprint-serverless",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "analyze:trajectory": "node ../scripts/trajectory/analyze.mjs",
    "backfill:timezone": "node ../scripts/trajectory/backfill-timezone.mjs",
    "dev": "node scripts/wrangler.mjs dev",
    "dev:api": "pnpm run dev",
    "dev:api:preview": "node scripts/wrangler.mjs dev --local --ip 127.0.0.1 --port 8787 --persist-to ../.local/console-preview/d1",
    "dev:console": "vite --config console/vite.config.ts",
    "preview:console": "vite preview --config console/vite.config.ts",
    "build": "pnpm run build:api && pnpm run build:console",
    "build:console": "vite build --config console/vite.config.ts",
    "build:api": "node scripts/wrangler.mjs deploy --dry-run --outdir ../dist/api",
    "typecheck": "tsc --noEmit && tsc --noEmit -p console/tsconfig.json",
    "test": "vitest",
    "test:ci": "vitest run && pnpm run test:console && pnpm run test:tools",
    "test:console": "vitest run --config console/vitest.config.ts",
    "check": "pnpm run typecheck && pnpm run db:migrate && pnpm run test:ci",
    "db:migrate": "node scripts/wrangler.mjs d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/wrangler.mjs d1 migrations apply DB --remote",
    "deploy:api": "pnpm run db:migrate:remote && node scripts/wrangler.mjs deploy",
    "cf-typegen": "node scripts/wrangler.mjs types --config api/wrangler.jsonc",
    "wrangler": "node scripts/wrangler.mjs",
    "test:tools": "node --test scripts/*.test.mjs",
    "cf:render:api": "node scripts/render-cloudflare.mjs api",
    "cf:render:console": "node scripts/render-cloudflare.mjs console",
    "cf:deploy:api": "node scripts/deploy-cloudflare.mjs api",
    "cf:deploy:console": "node scripts/deploy-cloudflare.mjs console",
    "build:console:worker": "node scripts/wrangler.mjs deploy --config console/wrangler.jsonc --dry-run --outdir ../dist/console"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "geo-tz": "^8.1.10",
    "playwright": "^1.64.0",
    "typescript": "^5.5.2",
    "vite": "^8.3.4",
    "vitest": "~4.1.0",
    "wrangler": "^4.148.0"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/noto-sans-hebrew": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@mapbox/mapbox-gl-rtl-text": "0.4.0",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "^3.14.14",
    "jose": "^6.2.12",
    "lucide-react": "^1.54.0",
    "mapbox-gl": "^3.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
