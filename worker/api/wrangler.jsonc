{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "footprint-serverless-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "keep_vars": true,
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "footprint",
    "migrations_dir": "migrations"
  }]
  // Runtime secret: INGEST_TOKEN. Console will provide this server-side.
  // Domains and deployment-specific database bindings are managed in Cloudflare.
}
