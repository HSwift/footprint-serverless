{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "@cloudflare/vitest-plugin/types"]
  },
  "include": ["worker-configuration.d.ts", "api/src/**/*.ts", "api/test/**/*.ts", "vitest.config.mts"]
}
